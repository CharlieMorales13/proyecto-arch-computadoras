# Valores por defecto del proyecto ECU (se aplican al generar sdkconfig por primera vez).
# Si ya existe sdkconfig y cambias algo aquí, borra sdkconfig o usa "idf.py fullclean".

CONFIG_IDF_TARGET="esp32"

# Tick de FreeRTOS a 1 kHz:
# vTaskDelayUntil() puede marcar el ciclo de 10 ms con precisión de 1 ms.
CONFIG_FREERTOS_HZ=1000

# CPU a 240 MHz y flash de 4 MB (ESP-WROOM-32)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Monitor serial a 115200 baudios
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
